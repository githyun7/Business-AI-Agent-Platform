# lightweight agent image
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Only install what the agent actually needs
RUN apt-get update && apt-get install -y \
    xvfb \
    xterm \
    xdotool \
    scrot \
    imagemagick \
    x11vnc \
    mutter \
    tint2 \
    net-tools \
    netcat \
    curl \
    git \
    python3 \
    python3-pip \
    software-properties-common \
    && add-apt-repository ppa:mozillateam/ppa \
    && apt-get install -y --no-install-recommends \
    firefox-esr \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# noVNC for browser-based VNC
RUN git clone --branch v1.5.0 https://github.com/novnc/noVNC.git /opt/noVNC \
    && git clone --branch v0.12.0 \
       https://github.com/novnc/websockify /opt/noVNC/utils/websockify \
    && ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html

# Create user
ENV USERNAME=computeruse
ENV HOME=/home/$USERNAME
RUN useradd -m -s /bin/bash -d $HOME $USERNAME \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER computeruse
WORKDIR $HOME

# Python deps for the agent loop only
COPY computer-use-demo/computer_use_demo/requirements.txt .
# Replace streamlit with just what we need
RUN pip3 install --no-cache-dir \
    anthropic[bedrock,vertex] \
    && pip3 install --no-cache-dir httpx

# Copy agent code (tools + loop only, no streamlit)
COPY computer-use-demo/computer_use_demo/ ./computer_use_demo/

# Copy startup scripts from original image folder
COPY computer-use-demo/image/xvfb_startup.sh .
COPY computer-use-demo/image/x11vnc_startup.sh .
COPY computer-use-demo/image/novnc_startup.sh .
COPY computer-use-demo/image/tint2_startup.sh .
COPY computer-use-demo/image/mutter_startup.sh .
COPY computer-use-demo/image/start_all.sh .

RUN chmod +x *.sh

ARG DISPLAY_NUM=1
ARG HEIGHT=768
ARG WIDTH=1024
ENV DISPLAY_NUM=$DISPLAY_NUM
ENV HEIGHT=$HEIGHT
ENV WIDTH=$WIDTH
ENV DISPLAY=:${DISPLAY_NUM}

# Entrypoint just starts the desktop environment
# The agent loop is triggered by the backend via a small HTTP server
COPY backend/agent_server.py .
CMD ["bash", "-c", "./start_all.sh && ./novnc_startup.sh && python3 agent_server.py"]